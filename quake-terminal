#!/bin/bash
# quake-terminal — F12 handler for the custom-built kitty quake fork.
#
# Toggle behavior:
#   * running instance?  -> toggle its visibility directly over the remote
#     control socket (fast, no process spawn per press)
#   * not running / wedged? -> kill any stale quake kitty processes
#     (self-heal) and spawn a fresh, visible instance
#
# This always pins OUR custom kitty build, never the system kitty (even when
# run from inside another kitty, whose KITTY_PID would redirect otherwise).
#
# When started without a session environment (keyd runs as a systemd service),
# the compositor socket is discovered from the cosmic-session process env.

Q="${HOME:-/home/toby}/quake-terminal"
K="$Q/kitty/linux-package/bin/kitten"

# --- session environment discovery (keyd / systemd context) ---
[ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR="/run/user/$(id -u)"
if [ -z "$WAYLAND_DISPLAY" ]; then
    # the compositor socket is simply wayland-N inside XDG_RUNTIME_DIR
    for s in "$XDG_RUNTIME_DIR"/wayland-*; do
        case "$s" in *.lock) continue ;; esac
        if [ -S "$s" ]; then WAYLAND_DISPLAY="${s##*/}"; break; fi
    done
    [ -n "$WAYLAND_DISPLAY" ] && export WAYLAND_DISPLAY
fi
[ -n "$DBUS_SESSION_BUS_ADDRESS" ] || export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

# --- debounce (failure-safe: any error lets the press through) ---
last=/tmp/quake-terminal.last
now=$(date +%s%N 2>/dev/null)
if [ -n "$now" ] && [ -r "$last" ]; then
    prev=$(head -1 "$last" 2>/dev/null | tr -cd '0-9')
    if [ -n "$prev" ]; then
        delta=$(( now - prev )) 2>/dev/null
        [ -n "$delta" ] && [ "$delta" -ge 0 ] && [ "$delta" -lt 350000000 ] 2>/dev/null && exit 0
    fi
fi
[ -n "$now" ] && echo "$now" > "$last" 2>/dev/null

{
  echo "== $(date +%H:%M:%S) HOME='$HOME' WAYLAND='$WAYLAND_DISPLAY' XDG='$XDG_RUNTIME_DIR'"
} >> /tmp/quake-terminal.wrapper.log 2>/dev/null

export KITTY_PATH_TO_KITTY_EXE="$Q/kitty/linux-package/bin/kitty"
unset KITTY_PID

# --- 1) fast path: toggle the running instance over its RC socket ---
if timeout 2 "$K" @ --to unix:@quake-kitty resize-os-window --action=toggle-visibility >/dev/null 2>&1; then
    echo "   -> toggled via RC socket" >> /tmp/quake-terminal.wrapper.log 2>/dev/null
    exit 0
fi

# --- 2) self-heal: kill stale/wedged quake instances ---
for p in $(pgrep -x kitty 2>/dev/null); do
    if tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | grep -q -- '--instance-group=quick-access'; then
        kill "$p" 2>/dev/null
        echo "   -> killed stale instance $p" >> /tmp/quake-terminal.wrapper.log 2>/dev/null
    fi
done
sleep 0.3

# --- 3) spawn a fresh instance (starts visible) ---
echo "   -> spawning fresh instance" >> /tmp/quake-terminal.wrapper.log 2>/dev/null
exec "$K" quick-access-terminal \
    --config "$Q/quick-access-terminal.conf" \
    --detach \
    --detached-log /tmp/quake-terminal.log
