#!/bin/bash
# quake-terminal — F12 handler for the custom-built kitty quake fork.
#
# Toggles the quick-access (quake style) terminal:
#   * if the quake kitty instance is already running, this toggles its
#     visibility (slide down from the top of the screen / slide up + hide)
#   * if it is not running, it is spawned visible
#
# This script always pins OUR custom kitty build (~/quake-terminal/kitty),
# never the system kitty, even when run from inside another kitty (whose
# KITTY_PID env var would otherwise redirect to that other binary).
#
# When started from a context without a session environment (e.g. keyd, which
# runs as root via runuser), the compositor socket is discovered from the
# cosmic-session process environment.
#
# A short debounce guards against double activation (e.g. the key being bound
# both in keyd and in the compositor's shortcut table after a reboot).

QUAKE_DIR="$HOME/quake-terminal"
KITTEN="$QUAKE_DIR/kitty/linux-package/bin/kitten"

# discover the session environment if we were spawned without one
if [ -z "$XDG_RUNTIME_DIR" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    cs_pid=$(pgrep -x cosmic-session 2>/dev/null | head -1)
    if [ -n "$cs_pid" ] && [ -r "/proc/$cs_pid/environ" ]; then
        session_env=$(tr '\0' '\n' < "/proc/$cs_pid/environ" 2>/dev/null)
        WAYLAND_DISPLAY=$(printf '%s\n' "$session_env" | grep -m1 '^WAYLAND_DISPLAY=' | cut -d= -f2-)
        DBUS_SESSION_BUS_ADDRESS=$(printf '%s\n' "$session_env" | grep -m1 '^DBUS_SESSION_BUS_ADDRESS=' | cut -d= -f2-)
        [ -n "$WAYLAND_DISPLAY" ] && export WAYLAND_DISPLAY
        [ -n "$DBUS_SESSION_BUS_ADDRESS" ] && export DBUS_SESSION_BUS_ADDRESS
    fi
fi

# debounce: ignore invocations within 400ms of the previous one
last="/tmp/quake-terminal.last"
now_ns=$(date +%s%N 2>/dev/null)
if [ -n "$now_ns" ] && [ -f "$last" ]; then
    prev=$(cat "$last" 2>/dev/null)
    if [ -n "$prev" ] && [ $((now_ns - prev)) -lt 400000000 ]; then
        exit 0
    fi
fi
[ -n "$now_ns" ] && echo "$now_ns" > "$last"

export KITTY_PATH_TO_KITTY_EXE="$QUAKE_DIR/kitty/linux-package/bin/kitty"
unset KITTY_PID

exec "$KITTEN" quick-access-terminal \
    --config "$QUAKE_DIR/quick-access-terminal.conf" \
    --detach \
    --detached-log /tmp/quake-terminal.log "$@"
